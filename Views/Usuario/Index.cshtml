@model List<UsuarioModel>
@{
    ViewData["Title"] = "Lista de Usuários";
}

<div class="d-grid gap-2 d-md-flex justify-content-md-start">
    <a class="btn btn-ligth" role="button" asp-controller="Usuario" asp-action="Criar">Adicionar</a>
</div>
<br />


@if (TempData["MensagemSucesso"] != null)
{
    <Center>
        <div class="alert alert-success" role="alert">
            <button type="button" class="btn btn-danger btn-sm close-alert" aria-label="Close">X</button>
            @TempData["MensagemSucesso"]
        </div>
    </Center>
}

@if (TempData["MensagemErro"] != null)
{
    <Center>
        <div class="alert alert-danger" role="alert">
            <button type="button" class="btn btn-danger btn-sm close-alert" aria-label="Close">X</button>
            @TempData["MensagemErro"]
        </div>
    </Center>
}

<h1>Listagem de Usuários</h1>

<table class="table table-dark table-striped" id="table-usuario">
    <thead>
        <tr>
            <th scope="col">#</th>
            <th scope="col">Nome</th>
            <th scope="col">Login</th>
            <th scope="col">Email</th>
            <th scope="col">Perfil</th>
            <th scope="col">Total de Contatos</th>
            <th scope="col">Data de Cadastro</th>
            <th scope="col"></th>
        </tr>
    </thead>
    <tbody>
        @if(Model != null && Model.Any())//Pergunta se a model não é nula e possui informação dentro
        {
            foreach (UsuarioModel usuario in Model)
            {
                <tr>
                    <th scope="row">@usuario.Id</th>
                    <td>@usuario.Nome</td>
                    <td>@usuario.Login</td>
                    <td>@usuario.Email</td>
                    <td>@(usuario.Perfil == Contato.Enums.PerfilEnum.Admin ? "Administrador" : "Padrão")</td>
                    <td>
                        <center><a href="javascript:" usuario-id="@usuario.Id" class="btn btn-success btn-sm btn-total-contatos">
                            @(usuario.Contatos != null && usuario.Contatos.Any() ? usuario.Contatos.Count : 0)
                        </a></center>
                    </td>
                    <td>@usuario.DataCadastro</td>
                    <td>
                        <center>
                            <div class="btn-group" role="group">
                                <a role="button" class="btn btn-warning" asp-route-id="@usuario.Id" asp-controller="Usuario" asp-action="Editar">Editar</a>
                                <a role="button" class="btn btn-danger" asp-route-id="@usuario.Id" asp-controller="Usuario" asp-action="Apagar">Apagar</a>
                            </div>
                        </center>
                    </td>
                </tr>
            }
        }
        else
        {
        <tr class="odd"><td valign="top" colspan="7"><center>Nenhum Usuário Encontrado</center></td></tr>    
        }
    </tbody>
</table>

<!--Modal-->
<div id="modalContatoUsuario" class="modal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Listagem de Contatos</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div id="listaContatosUsuario"></div>
            </div>
        </div>
    </div>
</div>
